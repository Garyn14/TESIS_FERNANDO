# Como el origen "servidor" de CloudFront: agrega el encabezado secreto, pone la IP del visitante al
# final de X-Forwarded-For y no reenvía Host (política AllViewerExceptHostHeader).
set $origen http://nginx:80;
proxy_pass $origen;
proxy_http_version 1.1;
proxy_set_header Host servidor-origen;
proxy_set_header X-Origen-Secreto "${ORIGEN_SECRETO}";
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_read_timeout 60s;
# Un 502 o 504 del servidor también se reemplaza por el aviso de apagado, como en CloudFront.
proxy_intercept_errors on;
